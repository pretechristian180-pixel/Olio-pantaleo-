# ─────────────────────────────────────────────────────────────
# Nexora Studio — variabili d'ambiente
# Copia in app/.env.local (app) e worker/.env (worker). Mai committare i valori veri.
# ─────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Solo server e worker: bypassa la RLS. Mai esporla al browser.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# AI — LLMProvider (Anthropic Claude). LLM_PROVIDER=anthropic in produzione.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# AI — TranscriptionProvider (Whisper via API OpenAI). TRANSCRIPTION_PROVIDER=demo solo in locale.
TRANSCRIPTION_PROVIDER=whisper
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1

# Montaggio (worker). Nel container Docker sono già impostati.
PYTHON_BIN=python3
MUSIC_DIR=/repo/music
WORK_DIR=/tmp/nexora-work
# Stima del costo di calcolo del render, per il costo per video (USD/minuto di video)
RENDER_USD_PER_MIN=0.004
# Cambio indicativo dollaro→euro per i costi nell'area admin (i fornitori fatturano in dollari)
USD_EUR_RATE=0.92

# B-roll stock — Pexels (gratuito, uso commerciale consentito). Senza chiave: video senza b-roll.
# BROLL_PROVIDER=pexels | demo (solo locale) | none
BROLL_PROVIDER=pexels
PEXELS_API_KEY=

# Pubblicazione — PublishingProvider (Metricool)
METRICOOL_API_TOKEN=
METRICOOL_USER_ID=

# Pagamenti — Stripe (Fase 5). Prodotti, prezzi e webhook: npm run stripe:setup (vedi docs/STRIPE.md).
# BILLING_PROVIDER=demo simula i pagamenti (solo sviluppo/test; STRIPE_WEBHOOK_SECRET = una stringa qualsiasi).
BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Coupon permanente dei founding member (creato da stripe:setup --founding-percent N)
STRIPE_FOUNDING_COUPON_ID=

# Email — Resend (dominio nexoragruppodigitale.it). EMAIL_PROVIDER=mailpit solo in locale.
RESEND_API_KEY=
EMAIL_FROM="Nexora Studio <studio@nexoragruppodigitale.it>"
# Avvisi al team Nexora quando un job fallisce definitivamente
ADMIN_ALERT_EMAIL=

# Worker (Railway)
WORKER_POLL_INTERVAL_MS=5000
WORKER_SCHEDULE_INTERVAL_MS=60000
# Domenica a quest'ora (ora italiana) si preparano gli script; lunedì a quest'ora parte l'email
SCRIPTS_GENERATE_HOUR=18
SCRIPTS_EMAIL_HOUR=8

# Solo sviluppo/test locali: permette LLM_PROVIDER=demo ed EMAIL_PROVIDER=mailpit con `next start`.
# MAI in produzione.
# ALLOW_DEMO_PROVIDERS=true

# Monitoraggio (Fase 7)
SENTRY_DSN=
