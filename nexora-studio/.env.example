# ─────────────────────────────────────────────────────────────
# Nexora Studio — variabili d'ambiente
# Copia in app/.env.local (app) e worker/.env (worker). Mai committare i valori veri.
# ─────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Solo server e worker: bypassa la RLS. Mai esporla al browser.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# AI — LLMProvider (Anthropic Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# AI — TranscriptionProvider (Whisper via API OpenAI)
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1

# Montaggio e b-roll — Horacle
HORACLE_API_KEY=
HORACLE_API_URL=

# Pubblicazione — PublishingProvider (Metricool)
METRICOOL_API_TOKEN=
METRICOOL_USER_ID=

# Pagamenti — Stripe (Fase 5)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Email — Resend (dominio nexoragruppodigitale.it)
RESEND_API_KEY=
EMAIL_FROM="Nexora Studio <studio@nexoragruppodigitale.it>"

# Worker (Railway)
WORKER_POLL_INTERVAL_MS=5000
WORKER_CONCURRENCY=1

# Monitoraggio (Fase 7)
SENTRY_DSN=
