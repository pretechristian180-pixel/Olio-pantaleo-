  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/**/*.test.js"
  },
  "devDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@supabase/supabase-js": "^2.119.0",
    "openai": "^7.51.0",
    "zod": "^4.6.7"
  }
}
