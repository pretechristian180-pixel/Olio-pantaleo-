{
  "name": "@nexora/video-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Motore di montaggio di Nexora Studio: timeline, sottotitoli, rilevamento volti, render FFmpeg.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "python", "assets"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/**/*.test.js"
  },
  "dependencies": {
    "zod": "^4"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5"
  }
}
