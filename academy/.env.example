# Nexora Academy — variabili d'ambiente
# Copia in .env.local (sviluppo) e in Vercel → Settings → Environment Variables (produzione).
# Le variabili NEXT_PUBLIC_* finiscono nel browser: mai mettere segreti lì.

# --- Sito ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Academy mostrata sul dominio principale (e su localhost / anteprime Vercel)
NEXT_PUBLIC_TENANT_SLUG=nexora
# Le academy dei clienti vivono su <cliente>.<questo dominio>
NEXT_PUBLIC_ROOT_DOMAIN=academy.nexoragruppodigitale.it
# Link del box "Prenota il Check Digitale Nexora" (facoltativo)
NEXT_PUBLIC_BOOKING_URL=
# Email per le richieste "offerta aziende" (facoltativa)
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Supabase (Fase 1) — Project Settings → API Keys ------------------------
NEXT_PUBLIC_SUPABASE_URL=
# "Publishable key" (sb_publishable_...) o, sui progetti vecchi, la "anon key"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret key" (sb_secret_...) o la "service_role key". SOLO SERVER: salta le RLS.
SUPABASE_SECRET_KEY=

# --- Bunny Stream (Fase 2 e 4) — Stream → la tua Library → API ---------------
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
# Security → Embed View Token Authentication → Token Authentication Key
BUNNY_STREAM_TOKEN_KEY=
# Es. vz-xxxxxxxx-xxx.b-cdn.net
BUNNY_STREAM_CDN_HOSTNAME=

# --- Stripe (Fase 3) — Developers → API keys / Webhooks ----------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Resend (Fase 3 e 5) — API Keys -----------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Nexora Academy <academy@tuodominio.it>"

# --- Cron Vercel (Fase 5): stringa casuale di almeno 16 caratteri -----------
CRON_SECRET=

# Vercel: registra in automatico il sottodominio di ogni nuova academy (certificato HTTPS).
# Token da Account Settings → Tokens, limitato al team. Segreto: solo sul server.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
